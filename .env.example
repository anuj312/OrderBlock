# Order X-Ray configuration. PLACEHOLDERS ONLY: copy to .env and fill in locally.
# Never commit .env. Never paste real keys/tokens into issues, screenshots or chat.

# demo = offline synthetic market (labelled DEMO) | kite = Zerodha Kite Connect
MARKET_MODE=demo

# Kite Connect (server-side only). Access tokens expire every day (~06:00 IST).
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Keep localhost: the terminal has no login of its own.
HOST=127.0.0.1
PORT=8010

# Board shape
BOARD_SIZE=10
PICKS=3
SECTOR_CAP=2

# Optional
# PUBLISH_SECONDS=2            # engine pass / board refresh interval
# HISTORY_RATE_PER_SEC=2.5     # Kite historical API limit is 3/s
# DEMO_SECONDS_PER_MINUTE=2    # demo: real seconds per market minute
# DEMO_START_MINUTE=150        # demo: start at 09:15 + N minutes
# CACHE_DIR=                   # daily history cache (default ./.cache)
